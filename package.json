{
  "name": "dsh-remote-control",
  "version": "0.2.1",
  "private": true,
  "description": "Control DeepSeek Harness sessions on another computer (worker + controller host plugins, zero external dependencies).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./worker": "./lib/worker.js",
    "./controller": "./lib/controller.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderdeng/dsh-remote-control.git"
  },
  "scripts": {
    "test": "node --test test/bridge.test.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
